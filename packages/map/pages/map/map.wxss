.page-main {
  padding-bottom: 40rpx;
}

.tip {
  margin: 20rpx 28rpx 22rpx;
  padding: 22rpx !important;
  background: rgba(255, 248, 231, 0.96) !important;
}

.tip-main {
  display: flex;
  align-items: center;
}

.tip-mark {
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #fce5a9, #e6b96d);
  font-size: 38rpx;
}

.tip-copy {
  flex: 1;
}

.tip-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text);
}

.tip-desc {
  margin-top: 5rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.map-actions {
  display: flex;
  align-items: center;
  margin: 18rpx -6rpx -2rpx;
}

.map-action {
  flex: 1;
  margin: 0 6rpx;
  padding: 14rpx 10rpx;
  text-align: center;
  border-radius: 14rpx;
  border: 2rpx solid var(--border);
  font-size: 23rpx;
  font-weight: 800;
}

.map-action.secondary {
  color: var(--text-sub);
  background: rgba(255, 255, 255, 0.72);
}

.map-action.primary {
  color: #fff;
  background: var(--primary);
  border-color: var(--primary-dark);
}

.map-action:active {
  transform: scale(0.98);
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 28rpx 12rpx;
}

.picker-title {
  color: var(--text);
  font-size: 27rpx;
  font-weight: 800;
}

.picker-note {
  color: var(--text-muted);
  font-size: 20rpx;
}

.map-wrap {
  margin: 2rpx 28rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  border: 3rpx solid var(--border);
  box-shadow: var(--shadow);
  background: #c8e0a8;
  position: relative;
  /* 隔离层，减少缩放时整页重绘闪烁 */
  transform: translateZ(0);
}

.map-location-badge {
  position: absolute;
  z-index: 5;
  left: 14rpx;
  top: 14rpx;
  display: flex;
  align-items: center;
  padding: 9rpx 13rpx;
  border-radius: 999rpx;
  color: #fff;
  background: rgba(48, 39, 28, 0.78);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
  font-size: 20rpx;
  pointer-events: none;
}

.map-location-name {
  margin-left: 7rpx;
  font-weight: 800;
}

.map-location-scale {
  margin-left: 9rpx;
  color: rgba(255, 255, 255, 0.68);
}

.gesture-hint {
  position: absolute;
  z-index: 5;
  right: 12rpx;
  bottom: 12rpx;
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(48, 39, 28, 0.64);
  font-size: 18rpx;
  pointer-events: none;
}

.map-disclaimer {
  margin: 10rpx 28rpx 0;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 248, 231, 0.9);
  border: 1rpx solid var(--border);
  font-size: 20rpx;
  color: var(--text-muted);
  line-height: 1.45;
}

.m-area {
  width: 100%;
  height: 100%;
  /* 背景色垫底，缩放边缘不透出闪白 */
  background: #c8e0a8;
}

/* 宽高由 js 按原图比例写成 px，避免 widthFix 在缩放时反复算高 */
.m-view {
  /* 禁止子节点影响布局 */
  overflow: hidden;
}

.map-img {
  width: 100%;
  height: 100%;
  display: block;
  /* 像素图尽量清晰；缩放交给 movable-view，别让 image 自己动画 */
  pointer-events: none;
  /* 保持图片自身采样，不对带文字的地图套用像素化滤镜。 */
  image-rendering: auto;
}

.area-section {
  margin-top: 30rpx;
  padding-bottom: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 0 28rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text);
}

.section-eyebrow {
  margin-bottom: 4rpx;
  color: var(--primary-dark);
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.section-desc {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: var(--text-muted);
}

.area-count {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: var(--primary-dark);
  background: rgba(232, 145, 58, 0.14);
  font-size: 20rpx;
  font-weight: 700;
}

.area-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 22rpx 12rpx;
}

.area-tab {
  width: calc(33.333% - 12rpx);
  margin: 0 6rpx 12rpx;
  padding: 15rpx 8rpx;
  border: 2rpx solid var(--border);
  border-radius: 15rpx;
  color: var(--text-sub);
  background: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.area-tab.active {
  color: #fff;
  border-color: var(--primary-dark);
  background: var(--primary);
  box-shadow: 0 6rpx 14rpx rgba(122, 75, 30, 0.18);
}

.area-tab-icon {
  margin-right: 5rpx;
}

@media (max-width: 350px) {
  .area-tab {
    width: calc(50% - 12rpx);
  }
}

.area-card {
  margin: 0 28rpx;
  padding: 24rpx !important;
  background: rgba(255, 255, 255, 0.96) !important;
}

.resident-box {
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(97, 150, 91, 0.1);
}

.resident-label {
  margin-bottom: 5rpx;
  color: #4d8149;
  font-size: 20rpx;
  font-weight: 800;
}

.detail-label {
  margin-top: 22rpx;
  color: var(--text);
  font-size: 22rpx;
  font-weight: 800;
}

.resident-value {
  color: var(--text-sub);
  font-size: 23rpx;
  line-height: 1.55;
}

.point-list {
  margin-top: 17rpx;
}

.point-item {
  display: flex;
  align-items: flex-start;
  padding: 9rpx 0;
}

.point-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin: 13rpx 15rpx 0 2rpx;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 0 0 5rpx rgba(232, 145, 58, 0.14);
}

.point-text {
  flex: 1;
  color: var(--text-sub);
  font-size: 23rpx;
  line-height: 1.55;
}

.page.dark .tip,
.page.dark .area-card {
  background: var(--bg-card) !important;
}

.page.dark .area-tab {
  background: var(--bg-card);
}

.page.dark .area-tab.active {
  background: var(--primary);
}

.page.dark .resident-box {
  background: rgba(111, 174, 103, 0.12);
}
