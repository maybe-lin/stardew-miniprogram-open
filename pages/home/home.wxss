/*
 * 首页布局：顶栏固定 + 下方 scroll-view 滚动
 * （fixed/sticky 在 page overflow 下会失效，所以不用 fixed）
 */
.page {
  height: 100vh;
  max-height: 100vh;
  overflow: hidden !important;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 0 !important;
}

.content {
  padding: 8rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 加载中 */
.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(61, 43, 31, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-box {
  background: rgba(255, 248, 231, 0.98);
  border: 2rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow);
}

.loading-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  margin-right: 16rpx;
  animation: spin 0.7s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 顶栏：flex 子项，不进滚动区 */
.search-wrap {
  position: relative;
  z-index: 20;
  flex-shrink: 0;
  padding: 12rpx 28rpx 12rpx;
  box-sizing: border-box;
  background: var(--bg, #F5E0C0);
  border-bottom: 1rpx solid var(--border);
}

/* 可滚动主体 */
.home-scroll {
  flex: 1;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}

.progress-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card, rgba(255, 248, 231, 0.94));
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
  box-shadow: var(--shadow);
}

.progress-edit {
  color: var(--primary-dark);
  font-size: 22rpx;
}

.item-row.out-season {
  opacity: 0.45;
  filter: grayscale(0.35);
}

.badge-in, .badge-out, .badge-rain {
  display: inline-block;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
  font-weight: 700;
  vertical-align: middle;
}
.badge-in { background: rgba(92,184,92,0.2); color: #3d8b3d; }
.badge-out { background: rgba(127,140,141,0.2); color: #7f8c8d; }
.badge-rain { background: rgba(91,192,222,0.25); color: #2a7a96; }

.badge-npc {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 9rpx;
  border-radius: 8rpx;
  color: #7a4c9a;
  background: rgba(157, 105, 190, 0.16);
  font-size: 17rpx;
  font-weight: 700;
  vertical-align: middle;
}

.result-arrow {
  flex-shrink: 0;
  padding-left: 12rpx;
  color: var(--primary);
  font-size: 40rpx;
  font-weight: 700;
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 3rpx solid var(--primary);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(232, 145, 58, 0.2);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  height: 48rpx;
  line-height: 48rpx;
}

.search-ph {
  color: var(--text-muted);
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  color: var(--text-sub);
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
}

.history-block .section-title {
  display: flex;
  justify-content: space-between;
  width: 100%;
}

.section-title {
  width: 100%;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 4rpx;
}

.link-clear {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 500;
  margin-left: auto;
}

.history-scroll {
  width: 100%;
  white-space: nowrap;
  height: auto;
  margin-bottom: 8rpx;
}

.history-chips {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 12rpx;
  padding: 2rpx 0;
}

.history-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
  flex-shrink: 0;
  line-height: 1.2;
  height: auto;
  box-sizing: border-box;
}

.history-name {
  max-width: 10em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.history-icon-img {
  width: 36rpx;
  height: 36rpx;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  flex-shrink: 0;
}

.fav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 248, 231, 0.95);
  border: 2rpx solid #E8C98A;
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  box-shadow: var(--shadow);
}

.fav-go {
  font-size: 22rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

/* 三大产品模块 */
.module-block {
  margin-bottom: 28rpx;
}

.module-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.module-emoji {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.module-titles {
  flex: 1;
}

.module-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}

.module-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 2rpx;
}

/* 4 列网格：不用 gap/calc，安卓兼容 */
.module-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  box-sizing: border-box;
}

.module-item {
  width: 25%;
  box-sizing: border-box;
  padding: 8rpx;
}

.module-item-inner {
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: 20rpx;
  padding: 16rpx 4rpx 14rpx;
  text-align: center;
  box-shadow: var(--shadow);
  box-sizing: border-box;
  min-height: 148rpx;
}

.module-item:active .module-item-inner {
  transform: scale(0.96);
  border-color: var(--primary);
}

.module-item-emoji {
  font-size: 40rpx;
  margin-bottom: 6rpx;
  line-height: 1.1;
}

/* 官方维基像素图标 */
.module-item-icon {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 8rpx;
  display: block;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

.module-item-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 4rpx;
}

.module-item-desc {
  font-size: 16rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 4rpx;
  line-height: 1.2;
}

/* 兼容旧 class 名（若有残留） */
.quick-grid { display: flex; flex-wrap: wrap; width: 100%; }
.quick-item { width: 25%; box-sizing: border-box; padding: 8rpx; }

.section-sub {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-muted);
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
  margin: 28rpx 0 12rpx;
}

.wiki-disclaimer {
  margin: 8rpx 0 48rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 248, 231, 0.92);
  border: 2rpx solid var(--border);
}

.wiki-disclaimer-title {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 8rpx;
}

.wiki-disclaimer-text {
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.55;
}

.wiki-disclaimer-more {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

.daily-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.daily-card {
  background: linear-gradient(135deg, #FFF3DC 0%, #FFE4B5 100%);
  border: 2rpx solid #E8C98A;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  /* 右侧给 badge 留空，避免标题与角标叠字 */
  padding-right: 140rpx;
  position: relative;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.daily-card.kind-festival {
  background: linear-gradient(135deg, #FFE8F0 0%, #FFD4E5 100%);
  border-color: #F0A0B8;
}

.daily-card.kind-birthday {
  background: linear-gradient(135deg, #E8F8FF 0%, #D4EEFF 100%);
  border-color: #8EC8E8;
}

.daily-card.kind-season {
  background: linear-gradient(135deg, #FFF3DC 0%, #FFE4B5 100%);
  border-color: #E8C98A;
}

.daily-card.kind-qos {
  background: linear-gradient(135deg, #E8F4FF 0%, #D4E8FF 100%);
  border-color: #8EB8E8;
}

/* 深色 class 在根 view.page 上，须用 .page.dark（page.dark 选不中） */
.page.dark .daily-card {
  background: linear-gradient(135deg, #3a2e28 0%, #4a3828 100%);
  border-color: #6a5030;
}

.page.dark .daily-card.kind-festival {
  background: linear-gradient(135deg, #3a2430 0%, #4a2838 100%);
  border-color: #6a4050;
}

.page.dark .daily-card.kind-birthday {
  background: linear-gradient(135deg, #243038 0%, #2a3848 100%);
  border-color: #405060;
}

.page.dark .daily-card.kind-qos {
  background: linear-gradient(135deg, #1e2838 0%, #243048 100%);
  border-color: #405878;
}

.daily-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  background: var(--primary);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  letter-spacing: 0;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kind-festival .daily-badge {
  background: #e74c7c;
}

.kind-birthday .daily-badge {
  background: #3a9fd8;
}

.kind-qos .daily-badge {
  background: #4a8fd8;
}

.daily-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 10rpx;
  padding-right: 8rpx;
  word-break: break-word;
  padding-right: 120rpx;
  line-height: 1.35;
}

.daily-emoji {
  margin-right: 6rpx;
}

.daily-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.55;
}

.daily-action {
  margin-top: 16rpx;
  color: var(--primary-dark);
  font-weight: 700;
  font-size: 26rpx;
}

.guide-row {
  display: flex;
  gap: 14rpx;
}

.guide-card {
  flex: 1;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: 18rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.guide-hover {
  border-color: var(--primary);
  transform: scale(0.96);
}

.guide-emoji {
  font-size: 36rpx;
}

.guide-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text);
}

.footer-tip {
  text-align: center;
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 40rpx;
  margin-bottom: 20rpx;
}

.tags {
  margin-bottom: 6rpx;
}

@media (max-width: 350px) {
  .search-wrap {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .content {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .module-item {
    width: 50%;
  }

  .module-item-inner {
    min-height: 136rpx;
  }

  .guide-row {
    flex-wrap: wrap;
  }

  .guide-card {
    min-width: calc(50% - 10rpx);
  }
}
