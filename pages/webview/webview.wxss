.fallback {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  background: transparent;
}

.fallback-card {
  background: rgba(209, 248, 255, 0.85);
  border: 1rpx solid #8DCAF0;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(10, 5, 35, 0.12);
}

.fallback-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a2a3a;
  margin-bottom: 16rpx;
}

.fallback-desc {
  font-size: 26rpx;
  color: #3a5566;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.fallback-url {
  font-size: 22rpx;
  color: #007448;
  word-break: break-all;
  background: rgba(255, 255, 255, 0.65);
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(141, 202, 240, 0.6);
}

.fallback-btn {
  text-align: center;
  background: #03A007;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx;
  border-radius: 12rpx;
  border: 1rpx solid #007448;
  text-shadow: 1px 1px #1e8e64;
  box-shadow: 0 1px rgba(0, 0, 0, 0.25);
}
