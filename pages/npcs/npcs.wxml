<view class="page {{darkMode ? 'dark' : ''}} season-{{uiSeason}}">
  <image class="page-bg" src="/images/app-bg.jpg" mode="scaleToFill" />
  <view class="season-deco">
    <view class="flake f1"></view>
    <view class="flake f2"></view>
    <view class="flake f3"></view>
    <view class="flake f4"></view>
    <view class="flake f5"></view>
  </view>
  <view class="page-main">
    <!-- 顶部栏 -->
    <view class="top-bar">
      <view class="top-title">村民图鉴</view>
      <view class="top-sub">{{progressText}} · 共收录 {{total}} 位村民</view>
      <view class="npc-search">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="搜名字 / 英文名 / 住址 / 最爱礼物"
          bindinput="onKeyword"
        />
        <text class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">✕</text>
      </view>
      <scroll-view scroll-x class="filter-scroll" enable-flex>
        <view class="filters">
          <view
            class="f-btn {{filter === item.key ? 'on' : ''}}"
            wx:for="{{filters}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="setFilter"
          >{{item.label}}</view>
        </view>
      </scroll-view>
    </view>

    <!-- 好感度机制（攻略核心） -->
    <view class="friend-tip card">
      <view class="friend-tip-h" bindtap="toggleFriendTip">
        <view>
          <view class="friend-tip-title">{{friendTip.title}}</view>
          <view class="friend-tip-sum">{{friendTip.summary}}</view>
        </view>
        <text class="friend-tip-arrow">{{showFriendTip ? '▾' : '▸'}}</text>
      </view>
      <view wx:if="{{showFriendTip}}" class="friend-tip-body">
        <view class="friend-tip-item" wx:for="{{friendTip.points}}" wx:key="title">
          <view class="friend-tip-item-t">{{item.title}}</view>
          <view class="friend-tip-item-d">{{item.text}}</view>
        </view>
        <view class="friend-tip-table">
          <view class="ft-row ft-head">
            <text class="ft-c">喜好</text>
            <text class="ft-c">平时</text>
            <text class="ft-c">冬星×5</text>
            <text class="ft-c">生日×8</text>
          </view>
          <view class="ft-row" wx:for="{{friendTip.giftTable}}" wx:key="level">
            <text class="ft-c">{{item.level}}</text>
            <text class="ft-c">{{item.normal}}</text>
            <text class="ft-c">{{item.feast}}</text>
            <text class="ft-c">{{item.birthday}}</text>
          </view>
        </view>
        <view class="friend-tip-note">{{friendTip.note}}</view>
      </view>
    </view>

    <!-- 双列网格（页面自然滚动，避免 scroll-view 高度算错变空白） -->
    <view class="grid">
      <view
        class="npc-card"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="card-upper" style="background: {{item.color}}22;">
          <image class="avatar" src="{{item.avatar}}" mode="aspectFit" wx:if="{{item.avatar}}" />
          <view class="avatar emoji" wx:else>{{item.emoji}}</view>
          <view class="badge bday" wx:if="{{item.isBirthday}}">🎂</view>
          <view class="badge event" wx:if="{{item.readyEvents}}">{{item.readyEvents}}</view>
          <view class="profile-tag" style="background: {{item.groupColor}};">{{item.groupLabel}}</view>
        </view>
        <view class="card-lower">
          <view class="name">{{item.name}} <text class="name-en">{{item.en}}</text></view>
          <view class="birthday {{item.isBirthday ? 'today' : ''}}">🎂 {{item.birthdayHint}}</view>
          <view class="meta">📍 {{item.home}}</view>
          <view class="loves-preview" wx:if="{{item.lovesPreview}}">🎁 {{item.lovesPreview}}</view>
          <view class="heart-row">
            <text class="heart-label">❤️ {{item.hearts}} / {{item.heartMax}}</text>
            <view class="heart-track"><view class="heart-fill" style="width: {{item.heartPercent}}%;"></view></view>
          </view>
          <view class="data-hint complete" wx:if="{{item.eventCount}}">🎬 {{item.eventCount}} 个爱心事件</view>
          <view class="data-hint complete" wx:if="{{item.giftComplete}}">✓ 完整送礼清单</view>
          <view class="data-hint" wx:elif="{{item.isFallback && !item.eventCount}}">基础资料 · 更多内容待补</view>
        </view>
      </view>
    </view>

    <view class="hint" wx:if="{{list.length}}">当前显示 {{list.length}} / {{total}} 位 · 点击查看送礼、事件与日程</view>
    <view class="empty-box" wx:else>
      <view class="empty-tip">没有匹配的村民</view>
      <view class="empty-action" wx:if="{{keyword}}" bindtap="clearKeyword">清除搜索</view>
    </view>
  </view>
</view>
