.legacy-redirect {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  color: var(--text);
  background: rgba(255, 248, 231, 0.72);
}

.redirect-icon {
  font-size: 80rpx;
}

.redirect-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.redirect-sub {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: 22rpx;
}
