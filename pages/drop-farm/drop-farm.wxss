.page-main {
  padding: 20rpx 28rpx 60rpx;
}

.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(61, 43, 31, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-box {
  background: rgba(255, 248, 231, 0.98);
  border: 2rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow);
}

.loading-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  margin-right: 16rpx;
  animation: df-spin 0.7s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

@keyframes df-spin {
  to { transform: rotate(360deg); }
}

.hero {
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FFF3DC 0%, #FFE4B5 100%) !important;
  border-color: #E8C98A !important;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
}

.hero-sub {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 700;
  margin-top: 6rpx;
}

.hero-src {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.hero-tip {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  line-height: 1.45;
}

.tabs {
  display: flex;
  margin: 16rpx 0 12rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 4rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-sub);
}

.tab.on {
  background: var(--primary);
  color: #fff;
}

.section-hint {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 600;
  margin: 8rpx 4rpx 16rpx;
}

.drop-card,
.mat-card,
.rule-card {
  padding: 22rpx 24rpx;
  margin-bottom: 4rpx;
}

.drop-head,
.mat-head {
  display: flex;
  align-items: center;
}

.drop-emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.drop-titles {
  flex: 1;
  min-width: 0;
}

.drop-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}

.drop-drop {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 600;
  margin-top: 4rpx;
}

.drop-arrow {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 700;
  padding-left: 12rpx;
}

.drop-floor {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #3d8b3d;
  background: rgba(92, 184, 92, 0.12);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.drop-method {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.55;
}

.drop-quest {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text);
  font-weight: 600;
}

.drop-detail {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
}

.detail-line {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.55;
  margin-top: 6rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.mini-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  margin: 4rpx 8rpx 4rpx 0;
  border-radius: 999rpx;
  background: rgba(232, 145, 58, 0.15);
  color: var(--primary-dark);
  font-weight: 600;
}

.expand-hint {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

.rule-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
}

.rule-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.55;
}

.footer-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.5;
  text-align: center;
  padding: 0 12rpx;
}
