.page-main {
  padding-bottom: 40rpx;
}

.head {
  margin: 24rpx 28rpx 12rpx;
  text-align: center;
  background: rgba(255, 248, 231, 0.95) !important;
}

.head-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
}

.head-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin: 8rpx 0 16rpx;
}

.head-num {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 700;
  margin-top: 12rpx;
}

.wiki-btn {
  margin-top: 16rpx;
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: var(--primary);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.cat-scroll {
  white-space: nowrap;
  padding: 8rpx 20rpx 12rpx;
  box-sizing: border-box;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid var(--border);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-sub);
  box-shadow: var(--shadow);
}

.cat-chip.on {
  background: var(--primary);
  border-color: var(--primary-dark);
  color: #fff;
}

.list {
  padding: 0 28rpx 20rpx;
}

.ach {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 22rpx;
  background: rgba(255, 255, 255, 0.96) !important;
  margin-bottom: 12rpx;
}

.ach.done {
  opacity: 0.7;
}

.ach-check {
  font-size: 34rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.ach-emoji {
  font-size: 36rpx;
  line-height: 1.2;
  flex-shrink: 0;
  width: 48rpx;
  text-align: center;
}

.ach-body {
  flex: 1;
  min-width: 0;
}

.ach-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.hidden-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  background: #9b59b6;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.ach-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  line-height: 1.45;
}

.ach-reward {
  font-size: 22rpx;
  color: var(--primary-dark);
  margin-top: 8rpx;
  font-weight: 600;
}

.ach.done .ach-name {
  text-decoration: line-through;
  color: var(--text-muted);
}

.empty {
  text-align: center;
  color: var(--text-muted);
  padding: 40rpx;
  font-size: 26rpx;
}

.footer {
  text-align: center;
  font-size: 20rpx;
  color: var(--text-muted);
  padding-bottom: 40rpx;
}
