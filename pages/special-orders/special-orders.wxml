<view class="page {{darkMode ? 'dark' : ''}} season-{{uiSeason}}">
  <image class="page-bg" src="/images/app-bg.jpg" mode="scaleToFill" />

  <view class="season-deco">
    <view class="flake f1"></view>
    <view class="flake f2"></view>
    <view class="flake f3"></view>
    <view class="flake f4"></view>
    <view class="flake f5"></view>
  </view>
  <view class="page-main">
    <view class="hero card">
      <view class="hero-title">{{meta.emoji}} {{meta.title}}</view>
      <view class="hero-sub">{{meta.subtitle}}</view>
      <view class="hero-unlock">解锁：{{meta.unlock}}</view>
      <view class="hero-rule" wx:for="{{meta.rules}}" wx:key="*this">· {{item}}</view>
      <view class="hero-src">{{meta.source}}</view>
    </view>

    <view class="search-row card">
      <input
        class="search-input"
        placeholder="搜序号 / 任务名 / 委托人…"
        value="{{keyword}}"
        bindinput="onSearch"
      />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">清空</view>
    </view>

    <view class="link-drop card" bindtap="goDropFarm">
      <text class="link-emoji">⚡</text>
      <view class="link-body">
        <view class="link-title">怪物掉落速刷</view>
        <view class="link-desc">五彩胶冻 · 灵外质 · 骷髅骨头 → 点此查看</view>
      </view>
      <text class="link-arrow">›</text>
    </view>

    <view class="count">共 {{filtered.length}} 条 · 点卡片展开速刷</view>

    <view
      class="card order-card"
      wx:for="{{filtered}}"
      wx:key="id"
    >
      <view class="order-head" data-id="{{item.id}}" bindtap="toggle">
        <view class="order-no">{{item.no}}</view>
        <view class="order-titles">
          <view class="order-name">{{item.name}}</view>
          <view class="order-client">委托人：{{item.client}} · 时限 {{item.days}}{{item.days === '本季内' || item.days === '见订单' ? '' : ' 天'}}</view>
        </view>
        <text class="order-arrow">{{expandedId === item.id ? '▾' : '›'}}</text>
      </view>

      <view class="order-goal">目标：{{item.goal}}</view>

      <view class="order-reward" wx:if="{{item.reward}}">
        <text class="reward-label">🎁 奖励</text>
        <text class="reward-text">{{item.reward}}</text>
      </view>

      <view class="order-farm" data-text="{{item.farm}}" catchtap="copyTip">
        💡 速刷：{{item.farm}}
      </view>

      <view class="order-more" wx:if="{{expandedId === item.id}}">
        <view class="more-line">可重复：{{item.repeat ? '是' : '否（注意）'}}</view>
        <view class="tag-row">
          <text class="mini-tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
        <view class="drop-link" wx:if="{{item.linkDrop}}" bindtap="goDropFarm">查看掉落物速刷层数 ›</view>
      </view>
    </view>

    <view wx:if="{{!filtered.length}}" class="empty">没有匹配的订单</view>
    <view class="footer-note">具体数量/鱼种/作物以游戏内订单文本为准；本页提供速刷方向与常用层数。</view>
    <view class="footer-note wiki-foot">数据参考星露谷中文维基等公开资料 · 仅供学习 · 非官方 · 请勿商用</view>
  </view>
</view>
